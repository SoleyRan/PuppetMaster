#pragma once

// Wire types published by the sensor team. Generated by CMake from
// messages.h.in, so the versions here and in topics.json come from one place:
// the version variables in this package's CMakeLists.txt. Raise one whenever
// its type's layout or meaning changes.

#include <cstdint>

#include <puppet_master/transport/typed.h>

namespace sensor_interfaces {

struct WheelSpeed {
    double meters_per_second;
    std::uint64_t sample;
};

struct ImuSample {
    double longitudinal_acceleration;  // m/s^2
    double yaw_rate;                   // rad/s
    std::uint64_t sample;
};

}  // namespace sensor_interfaces

template <>
struct puppet_master::transport::MessageTypeName<sensor_interfaces::WheelSpeed> {
    static constexpr const char* value = "vehicle.WheelSpeed";
    static constexpr std::uint32_t version = @WHEEL_SPEED_VERSION@;
};

template <>
struct puppet_master::transport::MessageTypeName<sensor_interfaces::ImuSample> {
    static constexpr const char* value = "vehicle.ImuSample";
    static constexpr std::uint32_t version = @IMU_SAMPLE_VERSION@;
};
