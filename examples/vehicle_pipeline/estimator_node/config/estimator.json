{
    "imports": ["estimation_interfaces/topics.json"],
    "scheduler": {"worker_count": 1},
    "components": [
        {
            "name": "state_estimator",
            "type": "state_estimator",
            "description": "fuses wheel speed and IMU into a vehicle state",
            "readers": [
                {"topic": "wheel", "freshness": "queued", "queue_depth": 8},
                {"topic": "imu", "freshness": "queued", "queue_depth": 8}
            ],
            "writers": ["state"],
            "parameters": {"wheel_gain": 0.8},
            "triggers": [{"kind": "data", "dependency_policy": "any", "data_topics": ["wheel", "imu"],
                          "deadline_ns": 5000000}]
        }
    ]
}
