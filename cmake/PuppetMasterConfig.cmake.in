@PACKAGE_INIT@

set(PUPPETMASTER_WITH_FASTDDS @PUPPETMASTER_ENABLE_FASTDDS@)
set(PUPPETMASTER_WITH_GOODLOG @PUPPETMASTER_ENABLE_GOODLOG@)
set(PUPPETMASTER_WITH_JSON_CONFIG @PUPPETMASTER_ENABLE_JSON_CONFIG@)
set(PUPPETMASTER_WITH_SHM @PUPPETMASTER_ENABLE_SHM@)

include(CMakeFindDependencyMacro)

find_dependency(Threads REQUIRED)

if(PUPPETMASTER_WITH_FASTDDS)
    find_dependency(fastcdr CONFIG REQUIRED)
    find_package(fastdds CONFIG QUIET)
    if(NOT fastdds_FOUND)
        find_dependency(fastrtps CONFIG REQUIRED)
    endif()
endif()

if(PUPPETMASTER_WITH_GOODLOG)
    find_dependency(GoodLog CONFIG REQUIRED)
endif()

if(PUPPETMASTER_WITH_JSON_CONFIG)
    find_dependency(nlohmann_json 3.11 CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/PuppetMasterTargets.cmake")

check_required_components(PuppetMaster)
